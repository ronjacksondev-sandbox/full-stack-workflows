{
  "extends": [
    "markuplint:recommended"
  ],
  "parser": {
    "\\.md$": "@markuplint/markdown-parser"
  },
  "excludeFiles": [
    "./_site/**/*",
    "./node_modules/**/*"
  ],
  "overrideMode": "merge",
  "overrides": {
    "./_includes/base.html": {
      "rules": {
        "required-h1": false
      }
    }
  }

}
